{
  "name": "@weldjs/http",
  "version": "2.0.6",
  "description": "End-to-End Type-Safe HTTP client. Offline-first, zero-config, framework agnostic.",
  "type": "module",
  "keywords": [
    "http",
    "fetch",
    "typescript",
    "type-safe",
    "offline-first",
    "zod",
    "react",
    "vue",
    "solid",
    "angular"
  ],
  "author": "Franco Romero",
  "license": "MIT",
  "homepage": "https://weld-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/lleaguen/WELD/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js",
      "require": "./dist/solid.cjs"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js",
      "require": "./dist/angular.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@preact/signals-core": "^1.6.0",
    "zod": "^3.22.0",
    "@weldjs/core": "^0.1.0",
    "@weldjs/react": "^0.2.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "vue": ">=3.3.0",
    "solid-js": ">=1.8.0",
    "rxjs": ">=7.0.0",
    "@weldjs/vue": ">=0.1.1",
    "@weldjs/solid": ">=0.1.0",
    "@weldjs/angular": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "@weldjs/vue": {
      "optional": true
    },
    "@weldjs/solid": {
      "optional": true
    },
    "@weldjs/angular": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "vue": "^3.4.0",
    "solid-js": "^1.8.0",
    "rxjs": "^7.8.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
