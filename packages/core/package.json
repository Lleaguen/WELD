{
  "name": "@weldjs/core",
  "version": "0.1.0",
  "description": "WELD core — E2E type-safe HTTP client engine",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@preact/signals-core": "^1.6.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
